{
  "name": "@chameleon-ui/contract",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "description": "JSON Schema and validation entry points for Chameleon UI component contracts",
  "files": ["dist", "schemas", "samples", "README.md"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./component-contract.schema.json": "./schemas/component-contract.schema.json"
  },
  "scripts": {
    "build": "node ./scripts/validate-schema.mjs && tsc -p tsconfig.json",
    "dev": "node ./scripts/validate-schema.mjs",
    "lint": "node --check ./scripts/validate-schema.mjs && tsc -p tsconfig.json --noEmit",
    "test": "node ./scripts/validate-schema.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "ajv": "8.17.1"
  }
}
