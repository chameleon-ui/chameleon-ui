{
  "name": "@chameleon-ui/adapter-a2ui",
  "version": "0.0.0",
  "private": false,
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "description": "A2UI protocol adapter for Chameleon UI. Maps A2UI documents to component slugs and install plans.",
  "files": ["dist", "demo", "README.md", "LICENSE"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "vitest",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@chameleon-ui/install-core": "workspace:*",
    "@chameleon-ui/registry": "workspace:*"
  },
  "devDependencies": {
    "@chameleon-ui/components-vue": "workspace:*",
    "@types/node": "20.19.0",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
