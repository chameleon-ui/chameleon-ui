{
  "$description": "Linear 1:1 flagship — dark-first. Reference: linear.app extracted CSS variables (layout.design/gallery/linear). Fonts and icons intentionally NOT replicated.",
  "radius": {
    "sm": { "$value": { "value": 4, "unit": "px" } },
    "md": { "$value": { "value": 6, "unit": "px" } },
    "lg": { "$value": { "value": 8, "unit": "px" } },
    "xl": { "$value": { "value": 8, "unit": "px" }, "$description": "Linear caps content-surface radius at 8px; only pill CTAs go full-round." }
  },
  "shadow": {
    "sm": {
      "$value": "0 0 0 1px rgba(255, 255, 255, 0.03) inset, 0 1px 1px rgba(0, 0, 0, 0.08), 0 4px 4px -1px rgba(0, 0, 0, 0.04)",
      "$description": "Linear elevation = border-opacity + faint inset highlight, not drop shadows. Drop part mirrors the app loading-screen shadow (#00000008/#00000014 class)."
    },
    "md": {
      "$value": "0 0 0 1px rgba(255, 255, 255, 0.04) inset, 0 4px 12px rgba(0, 0, 0, 0.45)"
    },
    "lg": {
      "$value": "0 0 0 1px rgba(255, 255, 255, 0.05) inset, 0 12px 32px rgba(0, 0, 0, 0.55)"
    }
  },
  "motion": {
    "duration": {
      "fast": { "$value": "100ms", "$description": "Linear duration-fast: 0.1s." },
      "base": { "$value": "160ms", "$description": "Linear duration-base: 0.16s — every interactive element transitions." },
      "slow": { "$value": "1200ms", "$description": "Linear duration-slow: 1.2s (large reveals only)." }
    },
    "easing": {
      "standard": { "$value": "cubic-bezier(0.45, 0, 0.55, 1)", "$description": "Linear ease-in-out-quad — evidence: app loading #appBorders transition-timing-function. Bounce/spring are forbidden." },
      "enter": { "$value": "cubic-bezier(0.25, 0.46, 0.45, 0.94)", "$description": "Linear ease-out-quad — evidence: marketing Button.css transitions (.16s var(--ease-out-quad))." },
      "exit": { "$value": "cubic-bezier(0.55, 0.085, 0.68, 0.53)", "$description": "Linear ease-in-quad for exits." }
    }
  },
  "blur": {
    "surface": { "$value": { "value": 0, "unit": "px" } },
    "overlay": { "$value": { "value": 0, "unit": "px" } },
    "thick": { "$value": { "value": 0, "unit": "px" } }
  },
  "border-width": {
    "$type": "dimension",
    "hairline": { "$value": { "value": 1, "unit": "px" } },
    "default": { "$value": { "value": 1, "unit": "px" } }
  },
  "color": {
    "palette": {
      "brand": { "$value": "#5e6ad2", "$description": "Linear accent-purple rgb(94,106,210) — CTAs and active states only." },
      "ink": { "$value": "#121213", "$description": "Linear app main canvas — evidence: --bg-base-color-dark #121213 (linear.app/login loading CSS)." },
      "paper": { "$value": "#09090a", "$description": "Linear app sidebar / chrome — evidence: --bg-sidebar-dark #09090a. Darker than the canvas." }
    },
    "background": {
      "default": { "$value": "{color.palette.ink}" },
      "subtle": { "$value": "{color.palette.paper}" },
      "elevated": { "$value": "#1c1c1d", "$description": "Cards / dialogs / raised chrome — evidence: --loading-error-secondary-bg-dark #1c1c1d (hover #252627)." },
      "inverse": { "$value": "#f7f8f8" }
    },
    "border": {
      "default": { "$value": "rgba(255, 255, 255, 0.08)", "$description": "Linear borders are white at 5–8% alpha, never solid gray." }
    },
    "fg": {
      "default": { "$value": "#f7f8f8", "$description": "Linear text-primary rgb(247,248,248)." },
      "muted": { "$value": "#8a8f98", "$description": "Linear text-secondary rgb(138,143,152)." },
      "inverse": { "$value": "{color.palette.ink}" }
    }
  },
  "typography": {
    "size": {
      "caption": { "$value": "0.75rem", "$description": "Linear font-size-xs: 12px (metadata)." },
      "body": { "$value": "0.875rem", "$description": "Linear font-size-md: 14px / line-height 21px." },
      "heading-3": { "$value": "1.25rem", "$description": "Linear h3: 20px." },
      "heading-2": { "$value": "1.5rem", "$description": "Linear font-size-2xl: 24px." },
      "heading-1": { "$value": "2rem", "$description": "Product display cap; Linear marketing 3xl is 48px." }
    },
    "line-height": {
      "tight": { "$value": 1.2 },
      "snug": { "$value": 1.33, "$description": "Linear h3: 20px / 26.6px." },
      "body": { "$value": 1.5, "$description": "Linear body: 14px / 21px." }
    },
    "weight": {
      "medium": { "$value": 510, "$description": "Linear variable-font medium axis value (not 500)." },
      "semibold": { "$value": 590, "$description": "Linear variable-font semibold axis value (not 600)." },
      "bold": { "$value": 590, "$description": "Linear never uses 600/700; bold maps to the 590 axis." }
    },
    "tracking": {
      "tight": { "$value": "-0.022em", "$description": "Linear negative tracking at display sizes." },
      "body": { "$value": "-0.011em", "$description": "Linear body tracking is slightly tight." }
    }
  }
}
