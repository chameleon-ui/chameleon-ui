{
  "radius": {
    "sm": { "$value": { "value": 2, "unit": "px" } },
    "md": { "$value": { "value": 2, "unit": "px" } },
    "lg": { "$value": { "value": 4, "unit": "px" } },
    "xl": { "$value": { "value": 6, "unit": "px" } }
  },
  "shadow": {
    "sm": {
      "$value": "0 1px 2px 0 rgba(0, 0, 0, 0.03), 0 1px 6px -1px rgba(0, 0, 0, 0.02)"
    },
    "md": {
      "$value": "0 1px 2px 0 rgba(0, 0, 0, 0.03), 0 2px 8px 0 rgba(0, 0, 0, 0.06)"
    },
    "lg": {
      "$value": "0 6px 16px 0 rgba(0, 0, 0, 0.08), 0 3px 6px -4px rgba(0, 0, 0, 0.12), 0 9px 28px 8px rgba(0, 0, 0, 0.05)"
    }
  },
  "motion": {
    "duration": {
      "fast": { "$value": "100ms" },
      "base": { "$value": "200ms" },
      "slow": { "$value": "300ms" }
    },
    "easing": {
      "standard": { "$value": "cubic-bezier(0.645, 0.045, 0.355, 1)" },
      "enter": { "$value": "cubic-bezier(0.08, 0.82, 0.17, 1)" },
      "exit": { "$value": "cubic-bezier(0.6, 0.04, 0.98, 0.34)" }
    }
  },
  "blur": {
    "surface": { "$value": { "value": 0, "unit": "px" } },
    "overlay": { "$value": { "value": 0, "unit": "px" } },
    "thick": { "$value": { "value": 0, "unit": "px" } }
  },
  "border-width": {
    "$type": "dimension",
    "hairline": { "$value": { "value": 1, "unit": "px" } },
    "default": { "$value": { "value": 1, "unit": "px" } }
  },
  "color": {
    "palette": {
      "brand": { "$value": "#1677ff" },
      "ink": { "$value": "#262626" },
      "paper": { "$value": "#ffffff" }
    },
    "background": {
      "default": { "$value": "{color.palette.paper}" },
      "subtle": { "$value": "#f5f5f5" },
      "elevated": { "$value": "{color.palette.paper}" },
      "brand-subtle": { "$value": "#e6f4ff" },
      "inverse": { "$value": "#001529" }
    },
    "border": {
      "default": { "$value": "#d9d9d9" }
    },
    "fg": {
      "default": { "$value": "{color.palette.ink}" },
      "muted": { "$value": "#8c8c8c" },
      "inverse": { "$value": "#ffffff" }
    }
  },
  "typography": {
    "line-height": {
      "body": { "$value": 1.55 }
    }
  }
}
