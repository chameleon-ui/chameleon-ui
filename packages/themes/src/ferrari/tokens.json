{
  "radius": {
    "$type": "dimension",
    "sm": { "$value": { "value": 0, "unit": "px" } },
    "md": { "$value": { "value": 0, "unit": "px" } },
    "lg": { "$value": { "value": 2, "unit": "px" } }
  },
  "shadow": {
    "sm": { "$value": "3px 3px 0 #0a0a0a" },
    "md": { "$value": "4px 4px 0 #0a0a0a" },
    "lg": { "$value": "6px 6px 0 #0a0a0a" }
  },
  "blur": {
    "$type": "dimension",
    "surface": { "$value": { "value": 0, "unit": "px" } },
    "overlay": { "$value": { "value": 0, "unit": "px" } },
    "thick": { "$value": { "value": 0, "unit": "px" } }
  },
  "motion": {
    "duration": {
      "fast": { "$value": "80ms" },
      "base": { "$value": "80ms" },
      "slow": { "$value": "120ms" }
    },
    "easing": {
      "standard": { "$value": "linear" },
      "enter": { "$value": "linear" },
      "exit": { "$value": "linear" }
    }
  },
  "font": {
    "family": {
      "sans": { "$value": "system-ui, 'Segoe UI', sans-serif" }
    },
    "weight": {
      "bold": { "$value": "800" },
      "semibold": { "$value": "700" }
    },
    "tracking": {
      "tight": { "$value": "-0.04em" }
    }
  },
  "border-width": {
    "$type": "dimension",
    "hairline": { "$value": { "value": 2, "unit": "px" } },
    "default": { "$value": { "value": 2, "unit": "px" } }
  },
  "color": {
    "palette": {
      "brand": { "$value": "#d40000" },
      "ink": { "$value": "#0a0a0a" },
      "paper": { "$value": "#ffffff" }
    },
    "background": {
      "default": { "$value": "{color.palette.paper}" },
      "subtle": { "$value": "#f3f3f3" },
      "elevated": { "$value": "#ffffff" },
      "inverse": { "$value": "{color.palette.ink}" }
    },
    "border": {
      "default": { "$value": "#0a0a0a" }
    },
    "fg": {
      "default": { "$value": "{color.palette.ink}" },
      "muted": { "$value": "#525252" },
      "inverse": { "$value": "#ffffff" }
    }
  },
  "typography": {
    "line-height": {
      "body": { "$value": 1.45 },
      "tight": { "$value": 1.1 }
    }
  }
}
