{
  "$description": "Apple 1:1 flagship — light-first. Reference: Human Interface Guidelines (developer.apple.com/design/human-interface-guidelines) color / typography / materials guidance, iOS system color ramp. Fonts (SF Pro) and icons (SF Symbols) intentionally NOT replicated; the font stack falls back to the platform system font.",
  "radius": {
    "$type": "dimension",
    "sm": { "$value": { "value": 8, "unit": "px" }, "$description": "Small controls (text fields, inline chips)." },
    "md": { "$value": { "value": 10, "unit": "px" }, "$description": "Content cards — iOS grouped-list cell corner radius." },
    "lg": { "$value": { "value": 14, "unit": "px" }, "$description": "Alerts / popovers (iOS alert corner radius)." },
    "xl": { "$value": { "value": 20, "unit": "px" }, "$description": "Sheets and large modal surfaces." }
  },
  "blur": {
    "$type": "dimension",
    "surface": { "$value": { "value": 20, "unit": "px" } },
    "frost": { "$value": { "value": 20, "unit": "px" }, "$description": "Navigation-bar / toolbar material (regular)." },
    "thick": { "$value": { "value": 40, "unit": "px" }, "$description": "Thick material for overlays and sheets." }
  },
  "saturate": {
    "$type": "number",
    "frost": { "$value": 1.8, "$description": "HIG materials pair blur with 180% saturation." }
  },
  "border": {
    "width": {
      "$type": "dimension",
      "hairline": { "$value": { "value": 1, "unit": "px" } },
      "default": { "$value": { "value": 1, "unit": "px" } }
    }
  },
  "shadow": {
    "sm": {
      "$value": "0 1px 2px rgba(0, 0, 0, 0.04)",
      "$description": "iOS content surfaces are nearly shadowless; separation comes from the grouped background."
    },
    "md": {
      "$value": "0 4px 16px rgba(0, 0, 0, 0.08)"
    },
    "lg": {
      "$value": "0 12px 40px rgba(0, 0, 0, 0.12)",
      "$description": "Large, soft overlay shadow (alerts, sheets) — never harsh."
    },
    "soft": { "$value": "{shadow.md}" },
    "overlay": { "$value": "{shadow.lg}" },
    "none": { "$value": "none" }
  },
  "effect": {
    "frost": { "$value": "saturate(180%) blur(20px)" },
    "frost-thick": { "$value": "saturate(180%) blur(40px)" }
  },
  "font": {
    "family": {
      "sans": {
        "$value": "system-ui, sans-serif",
        "$description": "Platform system font; SF Pro is deliberately not referenced."
      }
    },
    "weight": {
      "semibold": { "$value": 600 }
    }
  },
  "color": {
    "palette": {
      "brand": { "$value": "#007AFF", "$description": "iOS systemBlue (light) — links, primary actions, active tint." },
      "ink": { "$value": "#000000", "$description": "iOS label (light) is pure black." },
      "paper": { "$value": "#FFFFFF", "$description": "iOS systemBackground (light)." },
      "danger": { "$value": "#FF3B30", "$description": "iOS systemRed (light) — destructive actions." }
    },
    "background": {
      "default": { "$value": "#FFFFFF", "$description": "iOS systemBackground — primary (overall) view." },
      "subtle": { "$value": "#F2F2F7", "$description": "iOS systemGroupedBackground — grouped content canvas." },
      "elevated": { "$value": "#FFFFFF", "$description": "iOS secondarySystemGroupedBackground — grouped cells / cards." },
      "inverse": { "$value": "#000000" },
      "translucent": { "$value": "color-mix(in srgb, #f9f9f9 82%, transparent)", "$description": "Light bar material base." },
      "translucent-thick": { "$value": "color-mix(in srgb, #f9f9f9 94%, transparent)", "$description": "Light thick material base." }
    },
    "border": {
      "default": { "$value": "rgba(60, 60, 67, 0.29)", "$description": "iOS separator (light)." }
    },
    "fg": {
      "default": { "$value": "#000000", "$description": "iOS label (light)." },
      "muted": { "$value": "rgba(60, 60, 67, 0.6)", "$description": "iOS secondaryLabel (light)." },
      "inverse": { "$value": "#FFFFFF" }
    },
    "fill": {
      "$type": "color",
      "default": { "$value": "rgba(120, 120, 128, 0.2)", "$description": "iOS systemFill." },
      "secondary": { "$value": "rgba(120, 120, 128, 0.16)", "$description": "iOS secondarySystemFill — selection / active wash." },
      "tertiary": { "$value": "rgba(120, 120, 128, 0.12)", "$description": "iOS tertiarySystemFill — hover wash." },
      "quaternary": { "$value": "rgba(120, 120, 128, 0.08)", "$description": "iOS quaternarySystemFill — faintest grouping fill." }
    }
  },
  "motion": {
    "duration": {
      "fast": { "$value": "150ms", "$description": "Control state changes (hover, highlight)." },
      "base": { "$value": "300ms", "$description": "UIKit default animation duration (0.3s)." },
      "slow": { "$value": "500ms", "$description": "Sheet / large view transitions." }
    },
    "easing": {
      "standard": { "$value": "cubic-bezier(0.42, 0, 0.58, 1)", "$description": "UIKit ease-in-out." },
      "enter": { "$value": "cubic-bezier(0, 0, 0.2, 1)", "$description": "Decelerate into view." },
      "exit": { "$value": "cubic-bezier(0.4, 0, 1, 1)", "$description": "Accelerate out of view." }
    }
  },
  "typography": {
    "size": {
      "caption": { "$value": "0.75rem", "$description": "iOS Caption1: 12pt." },
      "body": { "$value": "1.0625rem", "$description": "iOS Body: 17pt — the default reading size." },
      "heading-3": { "$value": "1.25rem", "$description": "iOS Title3: 20pt." },
      "heading-2": { "$value": "1.75rem", "$description": "iOS Title1: 28pt." },
      "heading-1": { "$value": "2.125rem", "$description": "iOS Large Title: 34pt." }
    },
    "line-height": {
      "tight": { "$value": 1.21, "$description": "Large Title: 41/34." },
      "snug": { "$value": 1.25, "$description": "Title3: 25/20." },
      "body": { "$value": 1.29, "$description": "Body: 22/17." }
    },
    "tracking": {
      "tight": { "$value": "0.012em", "$description": "iOS Large Title carries slight positive tracking (+0.4pt at 34pt)." },
      "body": { "$value": "0em", "$description": "Body tracking left to the platform system font." }
    }
  }
}
