{
  "radius": {
    "$type": "dimension",
    "sm": { "$value": { "value": 4, "unit": "px" } },
    "md": { "$value": { "value": 6, "unit": "px" } },
    "lg": { "$value": { "value": 8, "unit": "px" } }
  },
  "shadow": {
    "sm": { "$value": "none" },
    "md": { "$value": "none" },
    "lg": { "$value": "none" }
  },
  "blur": {
    "$type": "dimension",
    "surface": { "$value": { "value": 0, "unit": "px" } },
    "overlay": { "$value": { "value": 0, "unit": "px" } },
    "thick": { "$value": { "value": 0, "unit": "px" } }
  },
  "motion": {
    "duration": {
      "fast": { "$value": "100ms" },
      "base": { "$value": "120ms" },
      "slow": { "$value": "180ms" }
    },
    "easing": {
      "standard": { "$value": "ease-out" },
      "enter": { "$value": "ease-out" },
      "exit": { "$value": "ease-in" }
    }
  },
  "font": {
    "family": {
      "sans": { "$value": "system-ui, 'Segoe UI', sans-serif" }
    },
    "weight": {
      "bold": { "$value": "800" },
      "semibold": { "$value": "700" }
    },
    "tracking": {
      "wide": { "$value": "0.08em" }
    }
  },
  "border-width": {
    "$type": "dimension",
    "hairline": { "$value": { "value": 2, "unit": "px" } },
    "default": { "$value": { "value": 2, "unit": "px" } }
  },
  "color": {
    "palette": {
      "brand": { "$value": "#f5c400" },
      "ink": { "$value": "#171717" },
      "paper": { "$value": "#fff6c2" }
    },
    "background": {
      "default": { "$value": "{color.palette.paper}" },
      "subtle": { "$value": "#ffe566" },
      "elevated": { "$value": "#fffce0" },
      "inverse": { "$value": "{color.palette.ink}" }
    },
    "border": {
      "default": { "$value": "#171717" }
    },
    "fg": {
      "default": { "$value": "{color.palette.ink}" },
      "muted": { "$value": "#4a4530" },
      "inverse": { "$value": "#fffce0" }
    }
  },
  "typography": {
    "line-height": {
      "body": { "$value": 1.35 },
      "tight": { "$value": 1.15 }
    }
  }
}
