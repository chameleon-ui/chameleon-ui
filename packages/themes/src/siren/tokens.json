{
  "radius": {
    "$type": "dimension",
    "sm": { "$value": { "value": 4, "unit": "px" } },
    "md": { "$value": { "value": 6, "unit": "px" } },
    "lg": { "$value": { "value": 8, "unit": "px" } }
  },
  "shadow": {
    "sm": { "$value": "none" },
    "md": { "$value": "none" },
    "lg": { "$value": "none" }
  },
  "blur": {
    "$type": "dimension",
    "surface": { "$value": { "value": 0, "unit": "px" } }
  },
  "motion": {
    "duration": {
      "fast": { "$value": "100ms" },
      "base": { "$value": "120ms" }
    },
    "easing": {
      "standard": { "$value": "ease-out" }
    }
  },
  "font": {
    "family": {
      "sans": { "$value": "system-ui, 'Segoe UI', sans-serif" }
    },
    "weight": {
      "bold": { "$value": "800" },
      "semibold": { "$value": "700" }
    },
    "tracking": {
      "wide": { "$value": "0.08em" }
    }
  },
  "color": {
    "palette": {
      "brand": { "$value": "#f5c400" },
      "ink": { "$value": "#171717" },
      "paper": { "$value": "#fff6c2" }
    },
    "background": {
      "subtle": { "$value": "#ffe566" },
      "elevated": { "$value": "#fffce0" }
    },
    "border": {
      "default": { "$value": "#171717" }
    },
    "fg": {
      "muted": { "$value": "#4a4530" }
    }
  },
  "typography": {
    "line-height": {
      "body": { "$value": 1.35 },
      "tight": { "$value": 1.15 }
    }
  }
}
