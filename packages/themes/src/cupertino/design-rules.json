{
  "version": "1.0",
  "typography": {
    "scale": "major-third",
    "lineHeightBody": 1.55,
    "fontFamilyToken": "font.family.sans",
    "headingWeightToken": "font.weight.semibold",
    "tracking": "tight"
  },
  "spacing": {
    "rhythm": 8,
    "density": "comfortable",
    "scale": {
      "strategy": "rem-steps",
      "steps": ["space.0", "space.1", "space.2", "space.3"]
    },
    "radiusStrategy": {
      "default": "radius.md",
      "interactive": "radius.md",
      "surface": "radius.xl"
    }
  },
  "colorBoundaries": {
    "accentUsage": "primary-and-links",
    "surfaceLayers": [
      "color.background.default",
      "color.background.subtle",
      "color.background.elevated"
    ],
    "disabledContrast": {
      "minimumRatio": 3,
      "foregroundToken": "color.fg.muted",
      "backgroundToken": "color.background.default"
    },
    "gradientPolicy": "subtle-only"
  },
  "forbiddenPatterns": [
    "harsh-shadows",
    "angular-corners",
    "high-chroma-gradients",
    "dense-typography",
    "material-elevation"
  ],
  "composition": {
    "surfaceHierarchy": "border-over-elevation",
    "preferredStacks": ["button", "input", "card"],
    "componentRules": {
      "Button": { "minWidthPx": 80, "maxWidthPx": 320, "minTouchTargetPx": 44 },
      "Input": { "minTouchTargetPx": 44 },
      "Card": { "minTouchTargetPx": 44 }
    }
  },
  "rtl": {
    "supported": true,
    "strategy": "logical-properties-only; no runtime DOM mirroring",
    "mirroredIcons": [
      "arrow-back",
      "arrow-forward",
      "chevron-start",
      "chevron-end",
      "breadcrumb-separator"
    ],
    "bidiIsolation": "required-for-user-content"
  }
}
