{
  "radius": {
    "$type": "dimension",
    "sm": { "$value": { "value": 12, "unit": "px" } },
    "md": { "$value": { "value": 16, "unit": "px" } },
    "lg": { "$value": { "value": 20, "unit": "px" } },
    "xl": { "$value": { "value": 28, "unit": "px" } }
  },
  "blur": {
    "$type": "dimension",
    "surface": { "$value": { "value": 20, "unit": "px" } },
    "frost": { "$value": { "value": 20, "unit": "px" } },
    "thick": { "$value": { "value": 40, "unit": "px" } }
  },
  "saturate": {
    "$type": "number",
    "frost": { "$value": 1.8 }
  },
  "border": {
    "width": {
      "$type": "dimension",
      "hairline": { "$value": { "value": 1, "unit": "px" } },
      "default": { "$value": { "value": 1, "unit": "px" } }
    }
  },
  "shadow": {
    "sm": { "$value": "{shadow.md}" },
    "md": {
      "$value": "0 1px 2px color-mix(in srgb, #000 6%, transparent), 0 8px 24px color-mix(in srgb, #000 8%, transparent)"
    },
    "lg": {
      "$value": "0 10px 40px color-mix(in srgb, #000 12%, transparent)"
    },
    "soft": { "$value": "{shadow.md}" },
    "overlay": { "$value": "{shadow.lg}" },
    "none": { "$value": "none" }
  },
  "effect": {
    "frost": { "$value": "saturate(180%) blur(20px)" },
    "frost-thick": { "$value": "saturate(180%) blur(40px)" }
  },
  "font": {
    "family": {
      "sans": {
        "$value": "-apple-system, BlinkMacSystemFont, \"SF Pro Text\", \"SF Pro Display\", system-ui, sans-serif"
      }
    },
    "weight": {
      "semibold": { "$value": 600 }
    }
  },
  "color": {
    "palette": {
      "brand": { "$value": "#007aff" },
      "ink": { "$value": "#1c1c1e" },
      "paper": { "$value": "#ffffff" }
    },
    "background": {
      "default": { "$value": "#f2f2f7" },
      "subtle": { "$value": "#e5e5ea" },
      "elevated": { "$value": "#ffffff" },
      "inverse": { "$value": "#1c1c1e" },
      "translucent": { "$value": "color-mix(in srgb, #ffffff 72%, transparent)" },
      "translucent-thick": { "$value": "color-mix(in srgb, #ffffff 86%, transparent)" }
    },
    "border": {
      "default": { "$value": "color-mix(in srgb, #3c3c43 29%, transparent)" }
    },
    "fg": {
      "default": { "$value": "#1c1c1e" },
      "muted": { "$value": "#8e8e93" },
      "inverse": { "$value": "#f2f2f7" }
    }
  },
  "motion": {
    "duration": {
      "fast": { "$value": "120ms" },
      "base": { "$value": "200ms" },
      "slow": { "$value": "280ms" }
    },
    "easing": {
      "standard": { "$value": "cubic-bezier(0.25, 0.1, 0.25, 1)" },
      "enter": { "$value": "cubic-bezier(0, 0, 0.2, 1)" },
      "exit": { "$value": "cubic-bezier(0.4, 0, 1, 1)" }
    }
  },
  "typography": {
    "line-height": {
      "body": { "$value": 1.47 }
    }
  }
}
