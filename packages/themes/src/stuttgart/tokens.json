{
  "radius": {
    "$type": "dimension",
    "sm": { "$value": { "value": 2, "unit": "px" } },
    "md": { "$value": { "value": 4, "unit": "px" } },
    "lg": { "$value": { "value": 6, "unit": "px" } },
    "interactive": { "$value": "{radius.sm}" },
    "surface": { "$value": "{radius.md}" }
  },
  "blur": {
    "$type": "dimension",
    "surface": { "$value": { "value": 0, "unit": "px" } }
  },
  "shadow": {
    "none": { "$value": "none" },
    "sm": {
      "$value": "0 1px 2px color-mix(in srgb, #000 55%, transparent), 0 0 0 1px color-mix(in srgb, #fff 6%, transparent)"
    },
    "md": {
      "$value": "0 4px 12px color-mix(in srgb, #000 48%, transparent), 0 1px 0 color-mix(in srgb, #fff 8%, transparent)"
    },
    "lg": {
      "$value": "0 12px 28px color-mix(in srgb, #000 58%, transparent), 0 0 0 1px color-mix(in srgb, #fff 5%, transparent)"
    }
  },
  "motion": {
    "duration": {
      "$type": "dimension",
      "fast": { "$value": { "value": 120, "unit": "ms" } },
      "base": { "$value": { "value": 180, "unit": "ms" } }
    },
    "easing": {
      "standard": { "$value": "cubic-bezier(0.25, 0.1, 0.25, 1)" }
    }
  },
  "font": {
    "family": {
      "sans": { "$value": "\"Helvetica Neue\", Helvetica, Arial, system-ui, sans-serif" }
    },
    "weight": {
      "semibold": { "$value": 600 },
      "bold": { "$value": 700 }
    },
    "tracking": {
      "tight": { "$value": "-0.015em" }
    }
  },
  "color": {
    "palette": {
      "brand": { "$value": "#bb0a30" },
      "ink": { "$value": "#eceef0" },
      "paper": { "$value": "#0f0f0f" }
    },
    "fg": {
      "default": { "$value": "{color.palette.ink}" },
      "inverse": { "$value": "#f7f7f5" },
      "muted": { "$value": "#9a9ea4" }
    },
    "background": {
      "default": { "$value": "{color.palette.paper}" },
      "inverse": { "$value": "#eceef0" },
      "subtle": { "$value": "#161616" },
      "elevated": { "$value": "#1c1c1e" }
    },
    "border": {
      "default": { "$value": "#3a3d42" }
    }
  },
  "typography": {
    "line-height": {
      "body": { "$value": 1.4 }
    }
  }
}
