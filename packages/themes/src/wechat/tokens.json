{
  "radius": {
    "$type": "dimension",
    "sm": { "$value": { "value": 6, "unit": "px" } },
    "md": { "$value": { "value": 8, "unit": "px" } },
    "lg": { "$value": { "value": 12, "unit": "px" } },
    "xl": { "$value": { "value": 16, "unit": "px" } }
  },
  "color": {
    "palette": {
      "brand": { "$value": "#07c160" },
      "ink": { "$value": "#191919" },
      "paper": { "$value": "#ffffff" },
      "bubble": { "$value": "#95ec69" }
    },
    "background": {
      "default": { "$value": "#ededed" },
      "subtle": { "$value": "#f7f7f7" },
      "elevated": { "$value": "#ffffff" },
      "inverse": { "$value": "#191919" }
    },
    "border": {
      "default": { "$value": "#e5e5e5" }
    },
    "fg": {
      "default": { "$value": "#191919" },
      "muted": { "$value": "#888888" },
      "inverse": { "$value": "#ffffff" }
    }
  },
  "border-width": {
    "$type": "dimension",
    "hairline": { "$value": { "value": 1, "unit": "px" } },
    "default": { "$value": { "value": 1, "unit": "px" } }
  },
  "font": {
    "family": {
      "sans": {
        "$value": "system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", sans-serif"
      }
    },
    "weight": {
      "medium": { "$value": "500" }
    }
  },
  "shadow": {
    "sm": { "$value": "none" },
    "md": { "$value": "0 1px 4px color-mix(in srgb, #000 6%, transparent)" },
    "lg": { "$value": "0 8px 24px color-mix(in srgb, #000 12%, transparent)" }
  },
  "blur": {
    "surface": { "$value": { "value": 0, "unit": "px" } },
    "overlay": { "$value": { "value": 0, "unit": "px" } },
    "thick": { "$value": { "value": 0, "unit": "px" } }
  },
  "motion": {
    "duration": {
      "fast": { "$value": "120ms" },
      "base": { "$value": "180ms" },
      "slow": { "$value": "220ms" }
    },
    "easing": {
      "standard": { "$value": "cubic-bezier(0.25, 0.1, 0.25, 1)" },
      "enter": { "$value": "cubic-bezier(0, 0, 0.2, 1)" },
      "exit": { "$value": "cubic-bezier(0.4, 0, 1, 1)" }
    }
  },
  "typography": {
    "size": {
      "caption": { "$value": "0.75rem" },
      "body": { "$value": "1.0625rem" },
      "heading-3": { "$value": "1.0625rem" },
      "heading-2": { "$value": "1.125rem" },
      "heading-1": { "$value": "1.25rem" }
    },
    "line-height": {
      "body": { "$value": 1.5 }
    }
  },
  "density": {
    "active": { "$value": 0.875 }
  }
}
