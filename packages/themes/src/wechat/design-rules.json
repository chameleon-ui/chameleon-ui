{
  "version": "1.0",
  "typography": {
    "scale": "major-second",
    "lineHeightBody": 1.5,
    "fontFamilyToken": "font.family.sans",
    "headingWeightToken": "font.weight.medium",
    "tracking": "normal"
  },
  "spacing": {
    "rhythm": 8,
    "density": "compact",
    "scale": {
      "strategy": "rem-steps",
      "steps": ["space.0", "space.1", "space.2", "space.3"]
    },
    "radiusStrategy": {
      "default": "radius.md",
      "interactive": "radius.sm",
      "surface": "radius.md"
    }
  },
  "colorBoundaries": {
    "accentUsage": "primary-actions-only",
    "surfaceLayers": [
      "color.background.default",
      "color.background.subtle",
      "color.background.elevated"
    ],
    "disabledContrast": {
      "minimumRatio": 3,
      "foregroundToken": "color.fg.muted",
      "backgroundToken": "color.background.default"
    },
    "gradientPolicy": "forbidden"
  },
  "forbiddenPatterns": [
    "card-heavy-layout",
    "oversized-headlines",
    "decorative-gradients",
    "high-chroma-accents",
    "frosted-glass",
    "spring-motion"
  ],
  "composition": {
    "surfaceHierarchy": "flat",
    "preferredStacks": ["list", "button", "divider", "chat-bubble"],
    "componentRules": {
      "Button": { "minWidthPx": 80, "maxWidthPx": 320, "minTouchTargetPx": 44 },
      "List": { "minTouchTargetPx": 44 },
      "ChatBubble": { "minTouchTargetPx": 44 }
    }
  },
  "rtl": {
    "supported": true,
    "strategy": "logical-properties-only; no runtime DOM mirroring",
    "mirroredIcons": [
      "arrow-back",
      "arrow-forward",
      "chevron-start",
      "chevron-end",
      "breadcrumb-separator"
    ],
    "bidiIsolation": "required-for-user-content"
  }
}
