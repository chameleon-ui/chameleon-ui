{
  "name": "@chameleon-ui/themes",
  "version": "0.2.0",
  "private": false,
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "description": "Phase 2 tribute themes (8) overlaying @chameleon-ui/tokens core with design-rules authority",
  "files": ["dist", "README.md", "LICENSE"],
  "sideEffects": ["**/*.css"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./dist/*": "./dist/*",
    "./line/css": {
      "style": "./dist/line/variables.css",
      "import": "./dist/line/variables.css",
      "default": "./dist/line/variables.css"
    },
    "./line/css?raw": "./dist/line/variables.css",
    "./silver-arrow/css": {
      "style": "./dist/silver-arrow/variables.css",
      "import": "./dist/silver-arrow/variables.css",
      "default": "./dist/silver-arrow/variables.css"
    },
    "./silver-arrow/css?raw": "./dist/silver-arrow/variables.css",
    "./stuttgart/css": {
      "style": "./dist/stuttgart/variables.css",
      "import": "./dist/stuttgart/variables.css",
      "default": "./dist/stuttgart/variables.css"
    },
    "./stuttgart/css?raw": "./dist/stuttgart/variables.css",
    "./corsa/css": {
      "style": "./dist/corsa/variables.css",
      "import": "./dist/corsa/variables.css",
      "default": "./dist/corsa/variables.css"
    },
    "./corsa/css?raw": "./dist/corsa/variables.css",
    "./cupertino/css": {
      "style": "./dist/cupertino/variables.css",
      "import": "./dist/cupertino/variables.css",
      "default": "./dist/cupertino/variables.css"
    },
    "./cupertino/css?raw": "./dist/cupertino/variables.css",
    "./siren/css": {
      "style": "./dist/siren/variables.css",
      "import": "./dist/siren/variables.css",
      "default": "./dist/siren/variables.css"
    },
    "./siren/css?raw": "./dist/siren/variables.css",
    "./wechat/css": {
      "style": "./dist/wechat/variables.css",
      "import": "./dist/wechat/variables.css",
      "default": "./dist/wechat/variables.css"
    },
    "./wechat/css?raw": "./dist/wechat/variables.css",
    "./ant-blue/css": {
      "style": "./dist/ant-blue/variables.css",
      "import": "./dist/ant-blue/variables.css",
      "default": "./dist/ant-blue/variables.css"
    },
    "./ant-blue/css?raw": "./dist/ant-blue/variables.css",
    "./line/meta": "./dist/line/meta.json",
    "./line/design-rules": "./src/line/design-rules.json",
    "./line/tokens": "./src/line/tokens.json",
    "./silver-arrow/meta": "./dist/silver-arrow/meta.json",
    "./silver-arrow/design-rules": "./src/silver-arrow/design-rules.json",
    "./silver-arrow/tokens": "./src/silver-arrow/tokens.json",
    "./stuttgart/meta": "./dist/stuttgart/meta.json",
    "./stuttgart/design-rules": "./src/stuttgart/design-rules.json",
    "./stuttgart/tokens": "./src/stuttgart/tokens.json",
    "./corsa/meta": "./dist/corsa/meta.json",
    "./corsa/design-rules": "./src/corsa/design-rules.json",
    "./corsa/tokens": "./src/corsa/tokens.json",
    "./cupertino/meta": "./dist/cupertino/meta.json",
    "./cupertino/design-rules": "./src/cupertino/design-rules.json",
    "./cupertino/tokens": "./src/cupertino/tokens.json",
    "./siren/meta": "./dist/siren/meta.json",
    "./siren/design-rules": "./src/siren/design-rules.json",
    "./siren/tokens": "./src/siren/tokens.json",
    "./wechat/meta": "./dist/wechat/meta.json",
    "./wechat/design-rules": "./src/wechat/design-rules.json",
    "./wechat/tokens": "./src/wechat/tokens.json",
    "./ant-blue/meta": "./dist/ant-blue/meta.json",
    "./ant-blue/design-rules": "./src/ant-blue/design-rules.json",
    "./ant-blue/tokens": "./src/ant-blue/tokens.json",
    "./community-focus-first/meta": "./src/community-focus-first/meta.json",
    "./community-focus-first/design-rules": "./src/community-focus-first/design-rules.json",
    "./community-focus-first/tokens": "./src/community-focus-first/tokens.json"
  },
  "scripts": {
    "build": "node ./scripts/build-themes.mjs && tsc -p tsconfig.json",
    "dev": "node ./scripts/build-themes.mjs",
    "lint": "node --check ./scripts/build-themes.mjs && node --check ./scripts/test-themes.mjs && node --check ./scripts/validate-rules.mjs && node --check ./scripts/test-themes-extends.mjs && node --check ./scripts/test-themes-regression.mjs && node --check ./scripts/test-themes-corsa-siren.mjs",
    "test": "node ./scripts/build-themes.mjs && node ./scripts/test-themes.mjs && node ./scripts/test-themes-corsa-siren.mjs && node ./scripts/test-themes-extends.mjs && node ./scripts/test-themes-regression.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "validate-rules": "node ./scripts/validate-rules.mjs"
  },
  "dependencies": {
    "@chameleon-ui/tokens": "workspace:*"
  },
  "devDependencies": {
    "@chameleon-ui/contract": "workspace:*",
    "ajv": "8.17.1",
    "typescript": "5.9.3"
  }
}
