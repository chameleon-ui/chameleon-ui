{
  "name": "@chameleon-ui/themes",
  "version": "0.4.0",
  "private": false,
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "description": "Phase 2 tribute themes (8) overlaying @chameleon-ui/tokens core with design-rules authority",
  "files": ["dist", "README.md", "LICENSE"],
  "sideEffects": ["**/*.css"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./dist/*": "./dist/*",
    "./linear/css": {
      "style": "./dist/linear/variables.css",
      "import": "./dist/linear/variables.css",
      "default": "./dist/linear/variables.css"
    },
    "./linear/css?raw": "./dist/linear/variables.css",
    "./mercedes/css": {
      "style": "./dist/mercedes/variables.css",
      "import": "./dist/mercedes/variables.css",
      "default": "./dist/mercedes/variables.css"
    },
    "./mercedes/css?raw": "./dist/mercedes/variables.css",
    "./porsche/css": {
      "style": "./dist/porsche/variables.css",
      "import": "./dist/porsche/variables.css",
      "default": "./dist/porsche/variables.css"
    },
    "./porsche/css?raw": "./dist/porsche/variables.css",
    "./ferrari/css": {
      "style": "./dist/ferrari/variables.css",
      "import": "./dist/ferrari/variables.css",
      "default": "./dist/ferrari/variables.css"
    },
    "./ferrari/css?raw": "./dist/ferrari/variables.css",
    "./apple/css": {
      "style": "./dist/apple/variables.css",
      "import": "./dist/apple/variables.css",
      "default": "./dist/apple/variables.css"
    },
    "./apple/css?raw": "./dist/apple/variables.css",
    "./tiktok/css": {
      "style": "./dist/tiktok/variables.css",
      "import": "./dist/tiktok/variables.css",
      "default": "./dist/tiktok/variables.css"
    },
    "./tiktok/css?raw": "./dist/tiktok/variables.css",
    "./wechat/css": {
      "style": "./dist/wechat/variables.css",
      "import": "./dist/wechat/variables.css",
      "default": "./dist/wechat/variables.css"
    },
    "./wechat/css?raw": "./dist/wechat/variables.css",
    "./alipay/css": {
      "style": "./dist/alipay/variables.css",
      "import": "./dist/alipay/variables.css",
      "default": "./dist/alipay/variables.css"
    },
    "./alipay/css?raw": "./dist/alipay/variables.css",
    "./linear/meta": "./dist/linear/meta.json",
    "./linear/design-rules": "./src/linear/design-rules.json",
    "./linear/tokens": "./src/linear/tokens.json",
    "./mercedes/meta": "./dist/mercedes/meta.json",
    "./mercedes/design-rules": "./src/mercedes/design-rules.json",
    "./mercedes/tokens": "./src/mercedes/tokens.json",
    "./porsche/meta": "./dist/porsche/meta.json",
    "./porsche/design-rules": "./src/porsche/design-rules.json",
    "./porsche/tokens": "./src/porsche/tokens.json",
    "./ferrari/meta": "./dist/ferrari/meta.json",
    "./ferrari/design-rules": "./src/ferrari/design-rules.json",
    "./ferrari/tokens": "./src/ferrari/tokens.json",
    "./apple/meta": "./dist/apple/meta.json",
    "./apple/design-rules": "./src/apple/design-rules.json",
    "./apple/tokens": "./src/apple/tokens.json",
    "./tiktok/meta": "./dist/tiktok/meta.json",
    "./tiktok/design-rules": "./src/tiktok/design-rules.json",
    "./tiktok/tokens": "./src/tiktok/tokens.json",
    "./wechat/meta": "./dist/wechat/meta.json",
    "./wechat/design-rules": "./src/wechat/design-rules.json",
    "./wechat/tokens": "./src/wechat/tokens.json",
    "./alipay/meta": "./dist/alipay/meta.json",
    "./alipay/design-rules": "./src/alipay/design-rules.json",
    "./alipay/tokens": "./src/alipay/tokens.json",
    "./community-focus-first/meta": "./src/community-focus-first/meta.json",
    "./community-focus-first/design-rules": "./src/community-focus-first/design-rules.json",
    "./community-focus-first/tokens": "./src/community-focus-first/tokens.json"
  },
  "scripts": {
    "build": "node ./scripts/build-themes.mjs && tsc -p tsconfig.json",
    "dev": "node ./scripts/build-themes.mjs",
    "lint": "node --check ./scripts/build-themes.mjs && node --check ./scripts/test-themes.mjs && node --check ./scripts/validate-rules.mjs && node --check ./scripts/test-themes-extends.mjs && node --check ./scripts/test-themes-regression.mjs && node --check ./scripts/test-themes-ferrari-tiktok.mjs",
    "test": "node ./scripts/build-themes.mjs && node ./scripts/test-themes.mjs && node ./scripts/test-themes-ferrari-tiktok.mjs && node ./scripts/test-themes-extends.mjs && node ./scripts/test-themes-regression.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "validate-rules": "node ./scripts/validate-rules.mjs"
  },
  "dependencies": {
    "@chameleon-ui/tokens": "workspace:*"
  },
  "devDependencies": {
    "@chameleon-ui/contract": "workspace:*",
    "ajv": "8.17.1",
    "typescript": "5.9.3"
  }
}
