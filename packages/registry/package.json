{
  "name": "@chameleon-ui/registry",
  "version": "0.2.0",
  "private": false,
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "description": "Registry catalog generated from packages/components + packages/blocks + official themes (8). Do not hand-edit published copies.",
  "files": ["dist", "registry", "README.md", "LICENSE"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "sync": "node ./scripts/sync-catalog.mjs",
    "test": "node ./scripts/sync-catalog.mjs --check && vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@chameleon-ui/install-core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "20.19.0",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
