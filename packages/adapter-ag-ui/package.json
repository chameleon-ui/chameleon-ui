{
  "name": "@chameleon-ui/adapter-ag-ui",
  "version": "0.2.0",
  "private": false,
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "description": "AG-UI protocol adapter (POC): bidirectional component-state ↔ agent-state sync and render-directive install plans. Not in L1/L2.",
  "files": ["dist", "demo", "README.md", "LICENSE", "DECISION.md"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "vitest",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "demo": "node ./demo/state-sync.mjs"
  },
  "dependencies": {
    "@chameleon-ui/install-core": "workspace:*",
    "@chameleon-ui/registry": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "20.19.0",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
