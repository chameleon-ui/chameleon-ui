{
  "name": "@chameleon-ui/components",
  "version": "0.2.0",
  "private": false,
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "description": "React component implementations. Import primitives, never @ark-ui/*.",
  "files": ["dist", "src", "catalog.json", "README.md", "LICENSE"],
  "sideEffects": ["**/*.css"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./catalog.json": "./catalog.json",
    "./contracts/*": "./src/*/contract.json",
    "./*": {
      "types": "./dist/*/index.d.ts",
      "import": "./dist/*/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node ./scripts/copy-css.mjs",
    "dev": "vitest",
    "lint": "tsc -p tsconfig.json --noEmit && node ../../../toolings/stylelint-config/scripts/lint-css.mjs \"./src/**/*.css\"",
    "test": "vitest run && node ../contract/scripts/validate-catalog-contracts.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@chameleon-ui/i18n": "workspace:*",
    "@chameleon-ui/primitives": "workspace:*",
    "@chameleon-ui/tokens": "workspace:*"
  },
  "devDependencies": {
    "@chameleon-ui/contract": "workspace:*",
    "@chameleon-ui/stylelint-config": "workspace:*",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.4",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "jsdom": "30.0.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "typescript": "5.9.3",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
