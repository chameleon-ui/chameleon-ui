{
  "schemaVersion": "0.2",
  "slug": "sheet",
  "name": "Sheet",
  "status": "experimental",
  "purpose": "Presents a modal panel anchored to an edge of the viewport.",
  "scenarios": [
    "Show a confirmation sheet",
    "Show a bottom action sheet",
    "Show a side sheet"
  ],
  "props": {
    "triggerLabel": {
      "type": "string",
      "required": true,
      "description": "Trigger button label."
    },
    "title": {
      "type": "string",
      "required": true,
      "description": "Sheet title."
    },
    "children": {
      "type": "node",
      "required": false,
      "description": "Sheet content."
    },
    "closeLabel": {
      "type": "string",
      "required": true,
      "description": "Close button label."
    },
    "position": {
      "type": "enum",
      "required": false,
      "description": "Edge anchor.",
      "values": [
        "start",
        "end",
        "bottom"
      ],
      "default": "bottom"
    },
    "open": {
      "type": "boolean",
      "required": false,
      "description": "Controlled open state."
    },
    "onOpenChange": {
      "type": "event",
      "required": false,
      "description": "Called when open state changes."
    },
    "className": {
      "type": "string",
      "required": false,
      "description": "Additional CSS classes."
    }
  },
  "variants": [
    {
      "name": "position",
      "values": [
        "start",
        "end",
        "bottom"
      ],
      "default": "bottom",
      "description": "Edge anchor."
    }
  ],
  "states": [
    {
      "name": "open",
      "description": "Sheet is visible."
    },
    {
      "name": "closed",
      "description": "Sheet is hidden."
    }
  ],
  "composition": {
    "allowedParents": [
      "app-shell",
      "page"
    ],
    "allowedChildren": [
      "text",
      "button",
      "form"
    ],
    "requiredContext": []
  },
  "antiPatterns": [
    "Do not open multiple sheets.",
    "Do not use for primary workflows."
  ],
  "a11y": {
    "role": "dialog",
    "keyboard": [
      "Tab cycles inside",
      "Escape closes"
    ],
    "focus": "Focus moves inside on open and returns on close.",
    "labeling": "Title labels the sheet.",
    "wcag": [
      "2.4.3",
      "2.1.1"
    ]
  },
  "responsive": {
    "strategy": "Bottom sheet on compact; side sheet on larger viewports.",
    "breakpoints": {
      "compact": "Bottom sheet.",
      "medium": "Positioned sheet.",
      "large": "Positioned sheet."
    }
  },
  "platforms": {
    "web": "supported",
    "react": "supported",
    "vue": "supported"
  },
  "rtl": {
    "supported": true,
    "strategy": "Logical CSS only; start/end refer to inline edges.",
    "mirroredValues": []
  },
  "dataAi": {
    "role": "sheet",
    "states": [
      "open",
      "closed"
    ],
    "intents": [
      "present-overlay"
    ]
  }
}
