      "card"
    ],
    "allowedChildren": [],
    "requiredContext": []
  },
  "antiPatterns": [
    "Do not use lists for layout.",
    "Do not mix ordered and unordered semantics without reason."
  ],
  "a11y": {
    "role": "list",
    "keyboard": [],
