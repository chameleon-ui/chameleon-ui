        "ordered",
        "none"
      ],
      "default": "unordered"
    },
    "className": {
      "type": "string",
      "required": false,
      "description": "Additional CSS classes."
    }
  },
  "variants": [
    {
      "name": "variant",
      "values": [
        "unordered",
        "ordered",
        "none"
      ],
      "default": "unordered",
