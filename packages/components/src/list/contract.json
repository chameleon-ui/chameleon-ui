{
  "schemaVersion": "0.2",
  "slug": "list",
  "name": "List",
  "status": "experimental",
  "purpose": "Renders a group of related items as a list.",
  "scenarios": [
    "Show a bullet list",
    "Show a numbered list",
    "Render a plain list of items"
  ],
  "props": {
    "items": {
      "type": "string",
