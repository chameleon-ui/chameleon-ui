{
  "name": "@chameleon-ui/vue",
  "version": "0.2.0",
  "private": false,
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "description": "Umbrella for Vue consumers: one dependency that pulls tokens, i18n, primitives-vue, themes, and components-vue.",
  "files": ["dist", "README.md", "LICENSE"],
  "sideEffects": ["**/*.css"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./css": {
      "types": "./dist/css.d.ts",
      "style": "./dist/css.css",
      "import": "./dist/css.css",
      "default": "./dist/css.css"
    },
    "./themes/*/css": {
      "style": "./dist/themes/*.css",
      "import": "./dist/themes/*.css",
      "default": "./dist/themes/*.css"
    },
    "./css-paths": {
      "types": "./dist/css-paths.d.ts",
      "import": "./dist/css-paths.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node ./scripts/build-css.mjs",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "node --test ./scripts/smoke.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "vue": "^3.5.0",
    "@ark-ui/vue": "5.38.1",
    "intl-messageformat": "11.2.13",
    "@formatjs/icu-messageformat-parser": "3.5.14"
  },
  "dependencies": {
    "@chameleon-ui/components-vue": "workspace:*",
    "@chameleon-ui/i18n": "workspace:*",
    "@chameleon-ui/primitives-vue": "workspace:*",
    "@chameleon-ui/themes": "workspace:*",
    "@chameleon-ui/tokens": "workspace:*"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vue": "3.5.13"
  }
}
