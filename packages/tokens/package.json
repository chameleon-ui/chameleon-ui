{
  "name": "@chameleon-ui/tokens",
  "version": "0.1.9",
  "private": false,
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "description": "DTCG design-token sources and deterministic CSS custom-property compiler",
  "files": ["dist", "README.md", "LICENSE"],
  "sideEffects": ["**/*.css"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./css": {
      "style": "./dist/css/variables.css",
      "import": "./dist/css/variables.css",
      "default": "./dist/css/variables.css"
    },
    "./density.css": {
      "style": "./dist/css/density.css",
      "import": "./dist/css/density.css",
      "default": "./dist/css/density.css"
    },
    "./dist/*": "./dist/*",
    "./tokens.json": "./dist/tokens.json",
    "./compiler": "./scripts/token-compiler.mjs"
  },
  "scripts": {
    "build": "node ./scripts/build-css-vars.mjs && tsc -p tsconfig.json",
    "dev": "node ./scripts/build-css-vars.mjs",
    "lint": "node --check ./scripts/token-compiler.mjs && node --check ./scripts/build-css-vars.mjs && node --check ./scripts/test-token-compiler.mjs",
    "test": "node ./scripts/test-token-compiler.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "style-dictionary": "4.3.3"
  }
}
