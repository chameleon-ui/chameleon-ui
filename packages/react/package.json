{
  "name": "@chameleon-ui/react",
  "version": "0.4.0",
  "private": false,
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "description": "Umbrella for React consumers: one dependency that pulls tokens, i18n, primitives, themes, and components.",
  "files": ["dist", "README.md", "LICENSE"],
  "sideEffects": ["**/*.css"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./css": {
      "types": "./dist/css.d.ts",
      "style": "./dist/css.css",
      "import": "./dist/css.css",
      "default": "./dist/css.css"
    },
    "./themes/*/css": {
      "style": "./dist/themes/*.css",
      "import": "./dist/themes/*.css",
      "default": "./dist/themes/*.css"
    },
    "./css-paths": {
      "types": "./dist/css-paths.d.ts",
      "import": "./dist/css-paths.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node ./scripts/build-css.mjs",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "node --test ./scripts/smoke.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@ark-ui/react": "5.38.0",
    "intl-messageformat": "11.2.13",
    "@formatjs/icu-messageformat-parser": "3.5.14"
  },
  "peerDependenciesMeta": {
    "@ark-ui/react": { "optional": false },
    "intl-messageformat": { "optional": false },
    "@formatjs/icu-messageformat-parser": { "optional": false }
  },
  "dependencies": {
    "@chameleon-ui/components-react": "workspace:*",
    "@chameleon-ui/i18n": "workspace:*",
    "@chameleon-ui/primitives": "workspace:*",
    "@chameleon-ui/themes": "workspace:*",
    "@chameleon-ui/tokens": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "typescript": "5.9.3"
  }
}
