{
  "name": "chameleon-ui",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.19.0",
    "pnpm": "9.15.0"
  },
  "scripts": {
    "build": "turbo run build --concurrency=4",
    "dev": "turbo run dev --concurrency=4",
    "lint": "turbo run lint --concurrency=4",
    "typecheck": "turbo run typecheck --concurrency=4",
    "test": "turbo run test --concurrency=4",
    "check": "turbo run lint --concurrency=4 && turbo run typecheck --concurrency=4 && turbo run test --concurrency=4 && turbo run build --concurrency=4",
    "poc:ark": "turbo run dev --filter=@chameleon-ui/poc-ark-ui",
    "poc:base": "turbo run dev --filter=@chameleon-ui/poc-base-ui",
    "demo": "turbo run dev --filter=@chameleon-ui/internal-demo",
    "demo:blind": "node ./scripts/blind-test-open.mjs",
    "blind:validate": "node ./scripts/blind-test-validate.mjs",
    "blind:ingest": "node ./scripts/blind-test-ingest.mjs",
    "docs": "turbo run dev --filter=@chameleon-ui/docs",
    "docs:build": "pnpm --filter @chameleon-ui/docs build",
    "studio": "turbo run dev --filter=@chameleon-ui/theme-studio",
    "market": "node ./scripts/market-dev.mjs",
    "bench:genui": "node ./scripts/run-genui-bench.mjs",
    "ci:phase0": "turbo run lint --concurrency=4 && turbo run typecheck --concurrency=4 && turbo run test --concurrency=4 && turbo run build --concurrency=4",
    "ci:phase1": "pnpm ci:phase0 && pnpm phase1:gates",
    "ci:phase2": "pnpm ci:phase1 && pnpm phase2:gates",
    "ci:phase3": "pnpm ci:phase2 && pnpm phase3:gates",
    "ci:phase4": "pnpm ci:phase3 && pnpm phase4:gates",
    "ci:phase5": "pnpm ci:phase4 && pnpm phase5:gates",
    "ci:phase6": "pnpm ci:phase5 && pnpm phase6:gates",
    "ci:phase7": "pnpm ci:phase6 && pnpm phase7:gates",
    "ci:phase8": "pnpm ci:phase4 && pnpm phase8:gates",
    "ci:phase9": "pnpm ci:phase8 && pnpm phase9:gates",
    "phase1:gates": "node ./scripts/validate-german-expansion.mjs && node ./toolings/stylelint-config/scripts/lint-css.mjs \"./poc/ark-ui/src/**/*.css\" \"./poc/base-ui/src/**/*.css\" \"./packages/**/*.css\" \"./apps/**/*.css\" && pnpm --filter @chameleon-ui/visual-regression test:playwright && pnpm perf:size && pnpm perf:lhci",
    "phase2:gates": "pnpm bench:genui && pnpm docs:build && node ./scripts/check-publish-ready.mjs",
    "phase3:gates": "node ./scripts/phase3-gates.mjs",
    "phase4:gates": "node ./scripts/phase4-gates.mjs",
    "phase5:gates": "node ./scripts/phase5-gates.mjs",
    "phase6:gates": "node ./scripts/phase6-gates.mjs",
    "phase7:gates": "node ./scripts/phase7-gates.mjs",
    "phase8:gates": "node ./scripts/phase8-gates.mjs",
    "phase9:gates": "node ./scripts/phase9-gates.mjs",
    "measure:touch-targets": "node ./scripts/measure-touch-targets.mjs",
    "publish:check": "node ./scripts/check-publish-ready.mjs",
    "ai:check": "node ./scripts/ai-check.mjs",
    "link:external": "node ./scripts/link-external.mjs",
    "pack:external": "node ./scripts/pack-external.mjs",
    "pack:source": "node ./scripts/pack-source.mjs",
    "verify:external": "node ./scripts/verify-external-templates.mjs",
    "verify:external:build": "node ./scripts/verify-external-templates.mjs --build",
    "perf:size": "node ./benchmarks/scripts/check-size.mjs",
    "perf:lhci": "node ./scripts/perf-lhci.mjs",
    "a11y:axe": "node ./scripts/a11y-axe-scan.mjs"
  },
  "devDependencies": {
    "@chameleon-ui/i18n": "workspace:*",
    "chrome-launcher": "1.2.1",
    "esbuild": "0.25.8",
    "lighthouse": "13.4.1",
    "turbo": "2.10.9",
    "typescript": "5.9.3"
  }
}
