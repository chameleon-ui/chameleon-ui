{
  "name": "chameleon-external-vite-vue",
  "private": true,
  "version": "0.1.9",
  "type": "module",
  "description": "Official Vite 6 + Vue 3 consumer template for unpublished @chameleon-ui/* (Windows included).",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@ark-ui/vue": "5.38.1",
    "@chameleon-ui/components-vue": "file:../../packages/components-vue",
    "@chameleon-ui/i18n": "file:../../packages/i18n",
    "@chameleon-ui/primitives-vue": "file:../../packages/primitives-vue",
    "@chameleon-ui/themes": "file:../../packages/themes",
    "@chameleon-ui/tokens": "file:../../packages/tokens",
    "@formatjs/icu-messageformat-parser": "3.5.14",
    "intl-messageformat": "11.2.13",
    "vue": "3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.8",
    "typescript": "5.9.3",
    "vite": "8.2.1",
    "vue-tsc": "3.3.8"
  }
}
