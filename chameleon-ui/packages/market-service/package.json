{
  "name": "@chameleon-ui/market-service",
  "version": "0.1.9",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0"
  },
  "type": "module",
  "description": "Phase 4 marketplace service: community themes + registry:rules packs, validation pipeline, install via kernel",
  "bin": {
    "chameleon-market": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@chameleon-ui/install-core": "workspace:*",
    "@chameleon-ui/themes": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "20.19.0",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
