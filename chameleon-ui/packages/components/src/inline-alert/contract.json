{
  "schemaVersion": "0.2",
  "slug": "inline-alert",
  "name": "InlineAlert",
  "status": "experimental",
  "purpose": "Displays a contextual message within a form or page.",
  "scenarios": [
    "Show a form-level error",
    "Explain a disabled field",
    "Highlight a tip"
  ],
  "props": {
    "children": {
      "type": "node",
      "required": true,
      "description": "Alert message."
    },
    "status": {
      "type": "enum",
      "required": false,
      "description": "Semantic tone.",
      "values": [
        "info",
        "success",
        "warning",
        "error"
      ],
      "default": "info"
    },
    "className": {
      "type": "string",
      "required": false,
      "description": "Additional CSS classes."
    }
  },
  "variants": [
    {
      "name": "status",
      "values": [
        "info",
        "success",
        "warning",
        "error"
      ],
      "default": "info",
      "description": "Semantic tone."
    }
  ],
  "states": [
    {
      "name": "default",
      "description": "Alert rendered."
    }
  ],
  "composition": {
    "allowedParents": [
      "form",
      "field",
      "page",
      "card"
    ],
    "allowedChildren": [
      "text"
    ],
    "requiredContext": []
  },
  "antiPatterns": [
    "Do not use for non-contextual global alerts.",
    "Do not hide the alert without a way to read it again."
  ],
  "a11y": {
    "role": "status",
    "keyboard": [],
    "focus": "Not focusable.",
    "labeling": "Contents are the alert message.",
    "wcag": [
      "4.1.3"
    ]
  },
  "responsive": {
    "strategy": "Full width within parent.",
    "breakpoints": {
      "compact": "Full width.",
      "medium": "Full width.",
      "large": "Full width."
    }
  },
  "platforms": {
    "web": "supported",
    "react": "supported",
    "vue": "planned"
  },
  "rtl": {
    "supported": true,
    "strategy": "Logical CSS only; accent on inline-start.",
    "mirroredValues": []
  },
  "dataAi": {
    "role": "inline-alert",
    "states": [
      "info",
      "success",
      "warning",
      "error"
    ],
    "intents": [
      "flag-field-error"
    ]
  }
}
