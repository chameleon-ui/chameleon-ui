{
  "schemaVersion": "0.2",
  "slug": "heading",
  "name": "Heading",
  "status": "experimental",
  "purpose": "Renders a semantic heading at a chosen level.",
  "scenarios": [
    "Page title",
    "Section heading",
    "Card heading"
  ],
  "props": {
    "children": {
      "type": "node",
      "required": true,
      "description": "Heading text."
    },
    "level": {
      "type": "enum",
      "required": false,
      "description": "Semantic heading level.",
      "values": [
        "level-1",
        "level-2",
        "level-3",
        "level-4",
        "level-5",
        "level-6"
      ],
      "default": "level-2"
    },
    "className": {
      "type": "string",
      "required": false,
      "description": "Additional CSS classes."
    }
  },
  "variants": [
    {
      "name": "level",
      "values": [
        "level-1",
        "level-2",
        "level-3",
        "level-4",
        "level-5",
        "level-6"
      ],
      "default": "level-2",
      "description": "Semantic heading level."
    }
  ],
  "states": [
    {
      "name": "default",
      "description": "Heading rendered."
    }
  ],
  "composition": {
    "allowedParents": [
      "app-shell",
      "page",
      "card",
      "dialog"
    ],
    "allowedChildren": [
      "text",
      "icon"
    ],
    "requiredContext": []
  },
  "antiPatterns": [
    "Do not skip heading levels for visual effect.",
    "Do not use heading styles on non-heading elements."
  ],
  "a11y": {
    "role": "heading",
    "keyboard": [],
    "focus": "Not focusable.",
    "labeling": "Contents provide the heading text.",
    "wcag": [
      "1.3.1"
    ]
  },
  "responsive": {
    "strategy": "Size scales with viewport.",
    "breakpoints": {
      "compact": "Smaller font size.",
      "medium": "Medium size.",
      "large": "Large size."
    }
  },
  "platforms": {
    "web": "supported",
    "react": "supported",
    "vue": "planned"
  },
  "rtl": {
    "supported": true,
    "strategy": "Logical CSS only.",
    "mirroredValues": []
  },
  "dataAi": {
    "role": "heading",
    "states": [
      "level-1",
      "level-2",
      "level-3",
      "level-4",
      "level-5",
      "level-6"
    ],
    "intents": [
      "structure-content"
    ]
  }
}
