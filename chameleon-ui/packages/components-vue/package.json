{
  "name": "@chameleon-ui/components-vue",
  "version": "0.1.0",
  "private": false,
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "description": "Vue component implementations. Import primitives-vue and tokens; never @ark-ui/*.",
  "files": ["dist", "src", "README.md", "LICENSE"],
  "sideEffects": ["**/*.css"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json --declaration --emitDeclarationOnly --outDir dist",
    "dev": "vitest",
    "lint": "vue-tsc --noEmit && node ../../toolings/stylelint-config/scripts/lint-css.mjs \"./src/**/*.css\"",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@chameleon-ui/primitives-vue": "workspace:*",
    "@chameleon-ui/tokens": "workspace:*"
  },
  "devDependencies": {
    "@chameleon-ui/contract": "workspace:*",
    "@chameleon-ui/stylelint-config": "workspace:*",
    "@vitejs/plugin-vue": "6.0.8",
    "@types/node": "20.19.0",
    "@vue/test-utils": "2.4.6",
    "jsdom": "30.0.1",
    "typescript": "5.9.3",
    "vite": "8.2.1",
    "vitest": "4.1.10",
    "vue": "3.5.13",
    "vue-tsc": "3.3.8"
  }
}
