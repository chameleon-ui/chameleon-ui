{
  "version": "1.0",
  "typography": {
    "scale": "major-second",
    "lineHeightBody": 1.35,
    "fontFamilyToken": "font.family.sans",
    "headingWeightToken": "font.weight.bold",
    "tracking": "wide"
  },
  "spacing": {
    "rhythm": 8,
    "density": "compact",
    "scale": {
      "strategy": "rem-steps",
      "steps": ["space.0", "space.1", "space.2", "space.3"]
    },
    "radiusStrategy": {
      "default": "radius.md",
      "interactive": "radius.sm",
      "surface": "radius.md"
    }
  },
  "colorBoundaries": {
    "accentUsage": "brand-highlights",
    "surfaceLayers": [
      "color.background.default",
      "color.background.subtle",
      "color.background.elevated"
    ],
    "disabledContrast": {
      "minimumRatio": 3,
      "foregroundToken": "color.fg.muted",
      "backgroundToken": "color.background.default"
    },
    "gradientPolicy": "brand-allowed"
  },
  "forbiddenPatterns": [
    "frost-glass",
    "luxury-blur",
    "rounded-pill-buttons",
    "sharp-corners",
    "neon-glow",
    "serif-headlines",
    "low-visibility"
  ],
  "composition": {
    "surfaceHierarchy": "border-over-elevation",
    "preferredStacks": ["alert", "badge", "button"],
    "componentRules": {
      "Button": { "minWidthPx": 88, "maxWidthPx": 340, "minTouchTargetPx": 44 },
      "Alert": { "minTouchTargetPx": 44 },
      "Badge": { "minTouchTargetPx": 44 }
    }
  },
  "rtl": {
    "supported": true,
    "strategy": "logical-properties-only; no runtime DOM mirroring",
    "mirroredIcons": [
      "arrow-back",
      "arrow-forward",
      "chevron-start",
      "chevron-end",
      "breadcrumb-separator"
    ],
    "bidiIsolation": "required-for-user-content"
  }
}
