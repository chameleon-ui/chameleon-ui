{
  "version": "1.0",
  "typography": {
    "scale": "minor-third",
    "lineHeightBody": 1.45,
    "fontFamilyToken": "font.family.sans",
    "headingWeightToken": "font.weight.bold",
    "tracking": "tight"
  },
  "spacing": {
    "rhythm": 8,
    "density": "compact",
    "scale": {
      "strategy": "rem-steps",
      "steps": ["space.0", "space.1", "space.2", "space.3"]
    },
    "radiusStrategy": {
      "default": "radius.sm",
      "interactive": "radius.sm",
      "surface": "radius.lg"
    }
  },
  "colorBoundaries": {
    "accentUsage": "brand-highlights",
    "surfaceLayers": [
      "color.background.default",
      "color.background.subtle",
      "color.background.elevated"
    ],
    "disabledContrast": {
      "minimumRatio": 3,
      "foregroundToken": "color.fg.muted",
      "backgroundToken": "color.background.default"
    },
    "gradientPolicy": "forbidden"
  },
  "forbiddenPatterns": [
    "rounded-pill-buttons",
    "low-contrast-red",
    "gradient-mesh",
    "pastel-accents",
    "frost-glass",
    "elastic-bounce",
    "luxury-blur"
  ],
  "composition": {
    "surfaceHierarchy": "border-over-elevation",
    "preferredStacks": ["button", "alert", "stack"],
    "componentRules": {
      "Button": { "minWidthPx": 80, "maxWidthPx": 300, "minTouchTargetPx": 44 },
      "Alert": { "minTouchTargetPx": 44 }
    }
  },
  "rtl": {
    "supported": true,
    "strategy": "logical-properties-only; no runtime DOM mirroring",
    "mirroredIcons": [
      "arrow-back",
      "arrow-forward",
      "chevron-start",
      "chevron-end",
      "breadcrumb-separator"
    ],
    "bidiIsolation": "required-for-user-content"
  }
}
