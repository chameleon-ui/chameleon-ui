{
  "radius": {
    "sm": { "$value": { "value": 2, "unit": "px" } },
    "md": { "$value": { "value": 4, "unit": "px" } },
    "lg": { "$value": { "value": 6, "unit": "px" } },
    "xl": { "$value": { "value": 8, "unit": "px" } }
  },
  "shadow": {
    "sm": { "$value": "none" },
    "md": {
      "$value": "0 1px 2px color-mix(in srgb, {color.palette.ink} 6%, transparent)"
    },
    "lg": {
      "$value": "0 4px 8px color-mix(in srgb, {color.palette.ink} 8%, transparent)"
    }
  },
  "motion": {
    "duration": {
      "fast": { "$value": "80ms" },
      "base": { "$value": "120ms" },
      "slow": { "$value": "180ms" }
    },
    "easing": {
      "standard": { "$value": "cubic-bezier(0.25, 0.1, 0.25, 1)" },
      "enter": { "$value": "cubic-bezier(0, 0, 0.2, 1)" },
      "exit": { "$value": "cubic-bezier(0.4, 0, 1, 1)" }
    }
  },
  "blur": {
    "surface": { "$value": { "value": 0, "unit": "px" } },
    "overlay": { "$value": { "value": 0, "unit": "px" } },
    "thick": { "$value": { "value": 0, "unit": "px" } }
  },
  "border-width": {
    "$type": "dimension",
    "hairline": { "$value": { "value": 1, "unit": "px" } },
    "default": { "$value": { "value": 1, "unit": "px" } }
  },
  "color": {
    "palette": {
      "brand": { "$value": "#111827" },
      "ink": { "$value": "#0a0a0a" },
      "paper": { "$value": "#ffffff" }
    },
    "background": {
      "default": { "$value": "{color.palette.paper}" },
      "subtle": { "$value": "#f4f5f6" },
      "elevated": { "$value": "{color.palette.paper}" },
      "inverse": { "$value": "{color.palette.ink}" }
    },
    "border": {
      "default": { "$value": "#e5e7eb" }
    },
    "fg": {
      "default": { "$value": "{color.palette.ink}" },
      "muted": { "$value": "#6b7280" },
      "inverse": { "$value": "#fafafa" }
    }
  },
  "typography": {
    "line-height": {
      "body": { "$value": 1.5 }
    }
  }
}
