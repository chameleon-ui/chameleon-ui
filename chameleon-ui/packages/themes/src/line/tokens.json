{
  "radius": {
    "sm": { "$value": { "value": 4, "unit": "px" } },
    "md": { "$value": { "value": 8, "unit": "px" } },
    "lg": { "$value": { "value": 12, "unit": "px" } },
    "xl": { "$value": { "value": 16, "unit": "px" } }
  },
  "shadow": {
    "sm": {
      "$value": "0 1px 2px color-mix(in srgb, {color.palette.ink} 5%, transparent)"
    },
    "md": {
      "$value": "0 4px 12px color-mix(in srgb, {color.palette.ink} 8%, transparent)"
    },
    "lg": {
      "$value": "0 12px 32px color-mix(in srgb, {color.palette.ink} 12%, transparent)"
    }
  },
  "motion": {
    "duration": {
      "fast": { "$value": "120ms" },
      "base": { "$value": "180ms" },
      "slow": { "$value": "240ms" }
    },
    "easing": {
      "standard": { "$value": "cubic-bezier(0.25, 0.1, 0.25, 1)" },
      "enter": { "$value": "cubic-bezier(0, 0, 0.2, 1)" },
      "exit": { "$value": "cubic-bezier(0.4, 0, 1, 1)" }
    }
  },
  "blur": {
    "surface": { "$value": { "value": 0, "unit": "px" } },
    "overlay": { "$value": { "value": 0, "unit": "px" } },
    "thick": { "$value": { "value": 0, "unit": "px" } }
  },
  "border-width": {
    "$type": "dimension",
    "hairline": { "$value": { "value": 1, "unit": "px" } },
    "default": { "$value": { "value": 1, "unit": "px" } }
  },
  "color": {
    "palette": {
      "brand": { "$value": "#171717" },
      "ink": { "$value": "#111110" },
      "paper": { "$value": "#fbfbfa" }
    },
    "background": {
      "default": { "$value": "{color.palette.paper}" },
      "subtle": { "$value": "#f4f3ef" },
      "elevated": { "$value": "#ffffff" },
      "inverse": { "$value": "{color.palette.ink}" }
    },
    "border": {
      "default": { "$value": "#e7e5e0" }
    },
    "fg": {
      "default": { "$value": "{color.palette.ink}" },
      "muted": { "$value": "#73716c" },
      "inverse": { "$value": "#fafafa" }
    }
  },
  "typography": {
    "line-height": {
      "body": { "$value": 1.5 }
    },
    "tracking": {
      "tight": { "$value": "-0.022em" },
      "body": { "$value": "-0.011em" }
    }
  }
}
