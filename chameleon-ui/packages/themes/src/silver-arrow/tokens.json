{
  "radius": {
    "$type": "dimension",
    "sm": { "$value": { "value": 0, "unit": "px" } },
    "md": { "$value": { "value": 2, "unit": "px" } },
    "lg": { "$value": { "value": 4, "unit": "px" } },
    "interactive": { "$value": "{radius.sm}" },
    "surface": { "$value": "{radius.lg}" }
  },
  "blur": {
    "$type": "dimension",
    "surface": { "$value": { "value": 0, "unit": "px" } }
  },
  "shadow": {
    "none": { "$value": "none" },
    "sm": { "$value": "0 1px 0 color-mix(in srgb, #0f172a 10%, transparent)" },
    "md": { "$value": "0 1px 2px color-mix(in srgb, #0f172a 12%, transparent)" },
    "lg": { "$value": "0 2px 4px color-mix(in srgb, #0f172a 14%, transparent)" }
  },
  "motion": {
    "duration": {
      "$type": "dimension",
      "fast": { "$value": { "value": 70, "unit": "ms" } },
      "base": { "$value": { "value": 100, "unit": "ms" } }
    },
    "easing": {
      "standard": { "$value": "cubic-bezier(0.2, 0, 0, 1)" }
    }
  },
  "font": {
    "family": {
      "sans": { "$value": "\"Segoe UI\", system-ui, sans-serif" }
    },
    "weight": {
      "semibold": { "$value": 600 },
      "bold": { "$value": 700 }
    },
    "tracking": {
      "tight": { "$value": "-0.03em" }
    }
  },
  "color": {
    "palette": {
      "brand": { "$value": "#5c6b7a" },
      "ink": { "$value": "#1a2330" },
      "paper": { "$value": "#f8fafc" }
    },
    "fg": {
      "muted": { "$value": "#5a6570" }
    },
    "background": {
      "subtle": { "$value": "#e8ecf1" },
      "elevated": { "$value": "#ffffff" }
    },
    "border": {
      "default": { "$value": "#b4bcc6" }
    }
  },
  "typography": {
    "line-height": {
      "body": { "$value": 1.45 }
    }
  }
}
